# =============================================
# PROTEKSI SERVER - KREATORPEDIA.COM
# =============================================

# 1. CEKAL DIRECTORY BROWSING
Options -Indexes

# 2. CEKAL ACCESS KE FILE TERTENTU
<FilesMatch "\.(env|json|lock|log|sql|bak|backup)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. PROTEKSI .HTACCESS ITU SENDIRI
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# 4. CEKAL HOTLINKING (gambar/video diambil orang lain)
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?ai-kids-studio\.vercel\.app [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?kreatorpedia\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|mp4|webm|svg)$ - [F,NC,L]

# 5. CEKAL USER AGENT YANG MENCURI KONTEN
RewriteCond %{HTTP_USER_AGENT} (wget|curl|python|java|php|perl|ruby|nmap|nikto) [NC]
RewriteRule .* - [F,L]

# 6. REDIRECT KE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 7. NONAKTIFKAN SERVER SIGNATURE
ServerSignature Off

# 8. CACHE CONTROL
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

# 9. HEADER KEAMANAN
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "no-referrer"
</IfModule>
